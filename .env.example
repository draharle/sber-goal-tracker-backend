# Скопируйте в .env и при необходимости поменяйте. Без .env берутся значения по умолчанию.

# PostgreSQL (docker-compose создаёт базу с этими параметрами)
DB_NAME=goal_tracker
DB_USERNAME=goal_tracker
DB_PASSWORD=goal_tracker
DB_PORT=5432
# Строка подключения для запуска сервиса без Docker (в docker-compose собирается сама)
DB_URL=jdbc:postgresql://localhost:5432/goal_tracker

# Порт HTTP
SERVER_PORT=8080

# Контекст Liquibase: demo — накатить демо-данные; prod (или любое другое) — только схема и справочник правил
LIQUIBASE_CONTEXTS=demo

# Дата снимка для прогонов, ГГГГ-ММ-ДД. Для демо фиксируем 2026-10-26, чтобы цифры совпадали с README.
# Пусто — текущая дата.
KKD_TODAY=2026-10-26
# Выполнить прогон при старте, если за дату снимка успешного прогона ещё нет
KKD_RUN_ON_STARTUP=true
KKD_ZONE=Europe/Moscow
